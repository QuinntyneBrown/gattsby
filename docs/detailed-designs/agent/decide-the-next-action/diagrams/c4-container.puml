@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decide the next action

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Agent orchestrator, model decider, decision state builder, model adapter")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Steps with their summaries, observations, hypotheses and decision timing")
}
System_Ext(nano, "Gemini Nano", "On-device model via Chrome's Prompt API")

Rel(person, spa, "Watches the running step; stops it", "Touch or keyboard")
Rel(spa, idb, "Reads the last summaries; commits the step and its timing")
Rel(spa, nano, "prompt(state, responseConstraint, signal)", "Prompt API")
@enduml
