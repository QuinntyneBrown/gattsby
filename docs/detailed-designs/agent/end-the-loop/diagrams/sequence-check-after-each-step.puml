@startuml
title UML sequence behaviour — Check after each step
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "VerdictPage" as page
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "PlaybookOrchestrator" as orch
  participant "StopConditions" as conditions
  participant "ConnectionReleaser" as releaser
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "finishTool" as finish
  participant "VerdictBuilder" as verdict
  participant "ProfileBuilder" as profile
end box

orch -> orch : Step n committed; progress.record(step)
orch -> conditions : check(progress, state, step)
alt Model returned finish and it succeeded
  conditions --> orch : finish
else Confidence >= 0.9 and checksDone
  conditions --> orch : confidenceReached
else 40 steps have run
  conditions --> orch : stepBudget (FR-045 AC1)
else 5 consecutive steps added no observation
  conditions --> orch : noProgress (FR-045 AC2, AC3)
else None applies
  conditions --> orch : null
  orch -> orch : Next step
end
opt A stop reason other than finish
  orch -> finish : run(verdict chosen by the orchestrator)
  finish -> verdict : supported(investigation)
  verdict --> finish : e.g. Partially decoded
  finish -> profile : build(investigation)
  profile --> finish : profileId
  finish --> orch : verdict, profileId
end
orch -> orch : Record LoopEnd: reason, step, note\n("step budget reached", "no progress")
orch -> releaser : release()
orch -> page : Open the verdict
@enduml
