@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — End the loop

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Stop conditions, orchestrator, finish tool, verdict and profile builders")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Steps, loop counters, stop reason, verdict and profile")
}
System_Ext(device, "Device", "Machine under investigation (Bluetooth LE)")

Rel(person, spa, "Stops the investigation; reads the verdict", "Touch or keyboard")
Rel(spa, idb, "Commits the stop reason, verdict and profile")
Rel(spa, device, "Disconnects", "Web Bluetooth")
@enduml
