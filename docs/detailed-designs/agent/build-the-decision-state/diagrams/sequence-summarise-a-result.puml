@startuml
title UML sequence behaviour — Summarise a result
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "ActivityFeed" as feed
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "ToolExecutor" as executor
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "subscribeAndRecordTool" as tool
  participant "KnowledgeBase" as kb
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "IndexedDbInvestigationStore" as store
end box

executor -> tool : run({ characteristics: [0x2ACD], seconds: 10 })
tool -> tool : 500 notifications recorded and decoded
tool -> kb : nameOf(0x2ACD)
kb --> tool : Treadmill Data
tool --> executor : ToolResult: data (full), summary,\nevidence IDs
executor -> executor : Enforce one line, at most 200 characters (FR-044)
alt Summary fits
  executor -> executor : "Recorded 500 Treadmill Data notifications in 10 s;\nspeed 3.0-6.0 km/h, distance +46 m" (FR-041 AC3)
else Summary too long or multi-line
  executor -> executor : Cut to 199 characters plus an ellipsis;\nrecord diagnostic with tool and stage (NFR-025)
end
executor -> store : commitStep(full output, summary, evidence)
executor -> feed : Show the summary as text
note over executor, store : The next DecisionState reads this summary,\nnot the 500 values
@enduml
