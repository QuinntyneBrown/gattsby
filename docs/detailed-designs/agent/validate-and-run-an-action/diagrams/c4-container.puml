@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Validate and run an action

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Action validator, tool executor, tool registry, tools, BLE layer, activity feed")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Steps, refusals, result envelopes and the raw log")
  Container(kb, "Knowledge base data", "Versioned JSON files", "Service names for summaries; safe limits")
}
System_Ext(device, "Device", "Machine under investigation (Bluetooth LE)")

Rel(person, spa, "Reads summaries as text", "Touch or keyboard")
Rel(spa, kb, "Reads names and safe limits")
Rel(spa, device, "Runs the tool's reads, subscriptions or approved writes", "Web Bluetooth")
Rel(spa, idb, "Commits each step in one transaction")
@enduml
