@startuml
title UML sequence behaviour — A request to another origin fails the spec
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Behaviour spec (Playwright)" as spec
participant "Network guard (guards.ts)" as guard
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "Gattsby web app" as app
end box
box "Browser and device" #F2F4F7
  participant "Chromium" as chromium
end box

spec -> guard : install(context): route every request
spec -> app : Run the scenario on localhost
alt Request to the app's own origin
  app -> chromium : GET /chunk.js
  chromium -> guard : route(localhost)
  guard --> chromium : continue
else Request to any other origin
  app -> chromium : fetch(other origin)
  note right of chromium : Deployed app: blocked by connect-src 'self' (NFR-012)
  chromium -> guard : route(other origin)
  guard -> guard : Record and abort
  guard --> spec : Fail: request off the app's origin (FR-075)
end
@enduml
