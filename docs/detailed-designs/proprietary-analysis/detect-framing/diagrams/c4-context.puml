@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Detect framing

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "IndexedDB holding the recordings")
System_Ext(nano, "Gemini Nano", "On-device model via the Prompt API (full agent mode only)")

Rel(person, gattsby, "Reads the frame in the activity feed and the device profile")
Rel(gattsby, chrome, "Reads a recording; writes the framing observation", "IndexedDB")
Rel(gattsby, nano, "Receives the one-line framing summary")
@enduml
