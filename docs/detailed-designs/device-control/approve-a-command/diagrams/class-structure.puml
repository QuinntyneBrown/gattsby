@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Approve a command

enum SafetyClass {
  read
  listen
  write
  control
  n/a
}

class ApprovalRequest {
  +id: string
  +toolName: string
  +safetyClass: SafetyClass
  +characteristic: string
  +bytes: Uint8Array
  +title: string
  +expectedEffect: string
  +risk: string
  +isMotion: boolean
  +sequence: string
}

class ApprovalDecision {
  +requestId: string
  +decision: "send" | "dontSend" | "cancelled"
  +standClearConfirmed: boolean
  +decidedAt: number
}

class ApprovalToken {
  +id: string
  +characteristic: string
  +bytes: Uint8Array
  +used: boolean
  +issuedAt: number
}

class ApprovalGate {
  -recentDenials: Map<string, number>
  +request(call: PendingCall, ctx: ToolContext): Promise<ApprovalToken | ToolError>
  +isDeniedRecently(call: PendingCall, step: number): boolean
}

class ApprovalLedger {
  -tokens: Map<string, ApprovalToken>
  +issue(request: ApprovalRequest): ApprovalToken
  +consume(id: string, characteristic: string, bytes: Uint8Array): ApprovalToken | ToolError
  +revokeAll(): void
}

abstract class BleLayer <<contract>> {
  +write(characteristic: string, bytes: Uint8Array, approvalId: string | null): Promise<ToolResult<void>>
}

class WebBluetoothBleLayer {
  +write(characteristic: string, bytes: Uint8Array, approvalId: string | null): Promise<ToolResult<void>>
}

class EmergencyStopController {
  +stopped: Signal<boolean>
  +trigger(): Promise<void>
}

class PromptChannel {
  +post(prompt: PersonPrompt): Promise<PromptResponse>
}

class ApprovalDialog <<component>> {
  +request: input<ApprovalRequest>
  +standClear: boolean
  +decided: output<ApprovalDecision>
}

ApprovalGate ..> ApprovalRequest : builds
ApprovalGate ..> PromptChannel : posts approval prompt
ApprovalGate --> ApprovalLedger : issues tokens
ApprovalGate ..> EmergencyStopController : checks latch
PromptChannel ..> ApprovalDialog : rendered by
ApprovalDialog ..> ApprovalDecision : emits
ApprovalLedger "1" *-- "*" ApprovalToken
BleLayer <|-- WebBluetoothBleLayer
WebBluetoothBleLayer --> ApprovalLedger : consumes token
EmergencyStopController ..> ApprovalLedger : revokeAll
ApprovalRequest --> SafetyClass
@enduml
