@startuml
title UML sequence behaviour — Skip, refusal or unexpected effect
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "InvestigationPage" as page
  participant "ApprovalDialog" as dialog
  participant "UnexpectedEffectDialog" as unexpected
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "PlaybookOrchestrator" as orch
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "sendCommandTool" as tool
  participant "CommandEffectChecker" as checker
end box
box "Browser and device" #F2F4F7
  participant "Device" as device
end box

alt The person skips the Control stage
  person -> page : Skip — finish read-only
  page --> orch : skipped
  orch -> orch : Observation "control skipped" (FR-052);\nfeatures claimed only from feature bits (FR-038 AC4)
else The device refuses the command
  orch -> tool : run(setResistance +1, approvalId)
  tool -> device : write 0x2AD9
  device --> tool : indicate 80 04 05
  tool --> orch : ok false, DEVICE_REJECTED "control not permitted"
  orch -> dialog : Failed: The bike refused the command
  orch -> orch : Feature refused; quirk recorded;\nno further command proposed
  person -> dialog : Finish read-only
else The data moves against the command
  orch -> checker : check(setSpeed, 6.0, 5.9, samples)
  checker --> orch : opposite, observed 9.2
  orch -> orch : Control abandoned; later control calls refused
  orch -> unexpected : Open: Speed jumped to 9.2 km/h
  note over unexpected : Nothing is written automatically (FR-034).\nEmergency stop is the first action;\nmock copy "I sent Stop" is an open item
  person -> unexpected : Tap Emergency stop (see emergency-stop)
end
@enduml
