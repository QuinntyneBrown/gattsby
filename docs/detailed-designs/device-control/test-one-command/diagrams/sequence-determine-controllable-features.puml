@startuml
title UML sequence behaviour — Determine controllable features
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "ProfileBuilder" as profile
  participant "ControllableFeatureResolver" as resolver
  participant "KnowledgeBase" as kb
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "IndexedDbInvestigationStore" as store
end box

profile -> resolver : resolve(investigation)
resolver -> store : Observations: feature bits (0x2ACC), ranges (TOOL-031),\ncontrol result, command effects, answers
store --> resolver : Observations with evidence IDs
loop each target-setting feature bit and each KB command
  resolver -> kb : command definition (op code, type, resolution, unit)
  kb --> resolver : setSpeed: 0x02, uint16, 0.01 km/h
  alt Tested: success, person Yes, data reached target
    resolver -> resolver : confirmed (FR-038 AC2)
  else Device answered non-success, or control refused
    resolver -> resolver : refused
  else Not tested, skipped, or effect not seen
    resolver -> resolver : claimedOnly (FR-038 AC4)
  end
  resolver -> resolver : Attach range and evidence IDs (FR-040)
end
resolver --> profile : target speed 0x02 uint16 0.01 km/h 0.5-16.0 confirmed;\ntarget incline 0x03 sint16 0.1 % 0-15 claimed only
@enduml
