@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Emergency stop

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "Web Bluetooth stack, device chooser, Prompt API, camera, IndexedDB")
System_Ext(nano, "Gemini Nano", "On-device model behind the Prompt API")
System_Ext(device, "Device", "Treadmill, bike, rower or cross-trainer under investigation (Bluetooth LE)")

Rel(person, gattsby, "Taps Emergency stop; says whether the machine stopped")
Rel(gattsby, chrome, "Writes Stop then Reset, or disconnects", "Web Bluetooth")
Rel(gattsby, nano, "Aborts a pending call", "Prompt API AbortSignal")
Rel(chrome, device, "GATT over Bluetooth LE, via Web Bluetooth")
@enduml
