@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Enumerate the GATT layout

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Inspection tools, BLE layer, missing-tool recorder")
  Container(kb, "Knowledge base data", "Versioned JSON files", "UUID names, decoders' data, blocklist, vendor entries")
  ContainerDb(idb, "Investigation database", "IndexedDB", "GATT layout, reads, unreachable services, missing-tool requests")
}
System_Ext(device, "Device", "Machine under investigation (Bluetooth LE)")

Rel(person, spa, "Follows the Identify stage", "Touch or keyboard")
Rel(spa, device, "getPrimaryServices(); getCharacteristics(); readValue()", "Web Bluetooth")
Rel(spa, kb, "Names known UUIDs; finds a decoder")
Rel(spa, idb, "Commits the layout and each read")
@enduml
