@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Match known profiles

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Matching tools, playbook heuristics, orchestrator, activity feed")
  Container(kb, "Knowledge base data", "Versioned JSON files", "Known profiles, vendor signatures, name patterns, manufacturer IDs")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Device facts, candidates and hypothesis versions")
}
System_Ext(nano, "Gemini Nano", "On-device model")

Rel(person, spa, "Reads the match; answers the checklist", "Touch or keyboard")
Rel(spa, kb, "Reads profiles and vendor signatures")
Rel(spa, idb, "Reads device facts; commits candidates")
Rel(spa, nano, "Only when ambiguous", "Prompt API")
@enduml
