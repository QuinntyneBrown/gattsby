@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Read the GATT layout

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "Web Bluetooth stack and GATT blocklist")
System_Ext(device, "Device", "Treadmill, bike, rower, cross-trainer or sensor under investigation (Bluetooth LE)")

Rel(person, gattsby, "Watches the services, maker and model appear")
Rel(gattsby, chrome, "Discovers services and reads values", "Web Bluetooth")
Rel(chrome, device, "GATT discovery and reads over Bluetooth LE")
@enduml
