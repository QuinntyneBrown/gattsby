@startuml
title UML sequence behaviour — Check capabilities when the app opens
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "ReadinessPage" as page
  participant "CapabilityList" as list
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "BrowserCapabilityDetector" as det
  participant "WebBluetoothBleLayer" as ble
  participant "PromptApiModelAdapter" as model
  participant "MediaDevicesCameraAdapter" as cam
  participant "IndexedDbInvestigationStore" as store
end box
box "Browser and device" #F2F4F7
  participant "Chrome APIs" as chrome
end box

person -> page : Open Gattsby (/start)
page -> list : Six items, "Checking" (loading)
page -> det : detect()
note over det : Probes run in parallel; the whole check is capped at 1 s (FR-001)
par
  det -> ble : availability()
  ble -> chrome : isSecureContext, 'bluetooth' in navigator
  ble -> chrome : bluetooth.getAvailability()
  chrome --> ble : true
  ble --> det : api, adapterAvailable, flags
else
  det -> model : import() then availability()
  model -> chrome : LanguageModel.availability(options)
  chrome --> model : "available"
  model --> det : available, imageInput
else
  det -> cam : import() then availability()
  cam --> det : getUserMedia present (no prompt, NFR-016)
else
  det -> store : usage()
  store -> chrome : indexedDB.open, storage.persisted(), estimate()
  store --> det : open, persisted, quota, usage
end
det --> page : Capabilities (never throws, NFR-021)
page -> page : toCapabilityItems(capabilities)
page -> list : Available, Needs action or Not available per item
list -> person : "Ready to investigate." Start enabled
@enduml
