@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Return a result envelope

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(nano, "Gemini Nano", "On-device model behind Chrome's Prompt API")
System_Ext(chrome, "Chrome", "Web Bluetooth stack, device chooser, Prompt API, camera, IndexedDB")
System_Ext(device, "Device", "Treadmill, bike, rower, cross-trainer or sensor under investigation (Bluetooth LE)")

Rel(person, gattsby, "Reads each step's summary or plain error message")
Rel(gattsby, nano, "Sends summaries and error codes, never raw data", "Prompt API")
Rel(gattsby, chrome, "Calls Web Bluetooth; records errors locally", "Web Bluetooth, IndexedDB")
Rel(chrome, device, "GATT over Bluetooth LE, via Web Bluetooth")
@enduml
