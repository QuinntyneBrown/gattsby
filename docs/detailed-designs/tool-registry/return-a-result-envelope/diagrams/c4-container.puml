Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Tools, tool executor, activity feed, error copy")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Steps with their envelopes, raw log, observations")
