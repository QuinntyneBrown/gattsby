@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Record and find varying fields

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Level prompts, recording tools, varying-bytes analysis")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Labelled recordings, raw log, observations")
  Container(kb, "Knowledge base data", "Versioned JSON files", "Level wording per device type")
}
System_Ext(device, "Device", "Machine with unknown services (Bluetooth LE)")

Rel(person, spa, "Taps Ready or Skip", "Touch or keyboard")
Rel(device, spa, "Notifies raw packets", "Web Bluetooth")
Rel(spa, kb, "Reads level wording")
Rel(spa, idb, "Stores recordings; reads them back for analysis")
@enduml
