@startuml
title UML sequence behaviour — Automatic power-cycle match, or fall back to guided
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "PromptCard" as card
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "Find-stage rules" as rules
  participant "ToolExecutor" as executor
  participant "PromptChannel" as channel
end box
box "Frontend — Gattsby web app: tools, analysis and knowledge base" #ECFDF3
  participant "PowerCycleMatchTool" as match
  participant "WatchAdvertisementsTool" as watch
  participant "PowerCycleDetector" as detector
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "CapabilityService" as caps
  participant "WebBluetoothBleLayer" as ble
end box
box "Browser and device" #F2F4F7
  participant "Chrome" as chrome
end box

rules -> caps : Advertisement watching available? (PD-ADV)
alt Available, three permitted candidates
  rules -> executor : power_cycle_match({ candidates: [A, B, C], mode: automatic })
  executor -> match : run(input)
  match -> watch : watch A, B and C (TOOL-004)
  watch -> ble : watchAdvertisements(id, seconds, signal)
  ble -> chrome : device.watchAdvertisements()
  chrome --> ble : advertisementreceived events
  match -> channel : post(action: "Switch the treadmill off")
  person -> card : Tap "It's off"
  card --> channel : offAt
  match -> channel : post(action: "Switch it on")
  person -> card : Tap "It's on"
  card --> channel : onAt
  ble --> watch : samples per candidate (hex bytes, RSSI)
  watch --> match : AdvertisementWatch x3
  match -> ble : Stop watching; remove listeners
  match -> detector : detect(samples, offAt, onAt)
  detector --> match : B stopped and resumed
  match --> executor : match B, method automatic (FR-013)
else Not available
  rules -> executor : power_cycle_match({ mode: automatic })
  executor -> match : run(input)
  match --> executor : UNSUPPORTED (TOOL-005)
  executor -> executor : Record missing-tool request for advertisement watching (TOOL-004)
  rules -> executor : power_cycle_match({ mode: guided })
  note right of executor : Continues as the guided match
end
@enduml
