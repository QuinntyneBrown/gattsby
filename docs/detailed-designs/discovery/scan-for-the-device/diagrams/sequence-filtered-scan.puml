@startuml
title UML sequence behaviour — Filtered scan from a tap
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "InvestigationPage" as page
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "ToolExecutor" as executor
  participant "PromptChannel" as channel
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "scanDevicesTool" as tool
  participant "KnowledgeBase" as kb
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "ScanOptionsBuilder" as builder
  participant "WebBluetoothBleLayer" as ble
end box
box "Browser and device" #F2F4F7
  participant "Chrome chooser" as chrome
end box

executor -> tool : run({ machineType: "treadmill", brand: "Horizon" })
tool -> builder : filtered("treadmill", "Horizon")
builder -> kb : knownServiceUuids(), blocklist, name prefixes
kb --> builder : UUIDs and prefixes, version 2026.11
builder --> tool : ScanRequest: filters incl. 0x1826, optionalServices minus blocklist (FR-067)
tool -> channel : post(tap: "Find the device")
channel -> page : Show prompt card and button
note over page, chrome : No chooser opens until the person taps (FR-011)
alt The person taps within 2 minutes
  person -> page : Tap "Find the device"
  page --> channel : tap response (user gesture)
  channel --> tool : tapped
  tool -> ble : requestDevice(options)
  ble -> ble : availability() is true
  ble -> chrome : navigator.bluetooth.requestDevice(options)
  person -> chrome : Pick HZN-T202-4F1A
  chrome --> ble : BluetoothDevice
  ble -> ble : Keep device by id; log scan entry (FR-073)
  ble --> tool : ChosenDevice { deviceId, name }
  tool --> executor : ok, "You picked HZN-T202-4F1A"
  executor -> executor : Commit step, observation and blocklisted UUIDs as unreachable
else No tap in 2 minutes
  channel --> tool : TIMEOUT
  tool --> executor : TIMEOUT, "The scan needs a tap by the person"
else Bluetooth is off or blocked
  person -> page : Tap "Find the device"
  page --> tool : tapped
  tool -> ble : requestDevice(options)
  ble -> ble : availability() is false
  ble --> tool : BLE_UNAVAILABLE; no chooser opened
  tool --> executor : BLE_UNAVAILABLE
end
@enduml
