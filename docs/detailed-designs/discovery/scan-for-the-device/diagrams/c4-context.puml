@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Scan for the device

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "Web Bluetooth stack, device chooser and Bluetooth permission")
System_Ext(device, "Device", "Treadmill, bike, rower, cross-trainer or sensor under investigation (Bluetooth LE)")

Rel(person, gattsby, "Taps Find the device; answers whether the machine was listed")
Rel(gattsby, chrome, "requestDevice with filters and optional services", "Web Bluetooth")
Rel(person, chrome, "Picks a device in the chooser or closes it")
Rel(device, chrome, "Advertises services and name", "Bluetooth LE")
@enduml
