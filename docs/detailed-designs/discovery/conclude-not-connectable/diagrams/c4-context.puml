@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Conclude not connectable

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "Web Bluetooth stack, device chooser, Prompt API, camera, IndexedDB")
System_Ext(device, "Device", "Treadmill, bike, rower, cross-trainer or sensor under investigation (Bluetooth LE)")

Rel(person, gattsby, "Confirms power, no other connection and range; reads the verdict")
Rel(gattsby, chrome, "Repeats the scan", "Web Bluetooth")
Rel(chrome, device, "GATT over Bluetooth LE, via Web Bluetooth (never seen)")
@enduml
