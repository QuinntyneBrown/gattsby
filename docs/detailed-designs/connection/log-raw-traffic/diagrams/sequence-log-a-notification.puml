@startuml
title UML sequence behaviour — Log a burst of notifications
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "InvestigationPage" as page
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "WebBluetoothBleLayer" as ble
  participant "HexCodec" as hex
  participant "RawTrafficLog" as log
  participant "IndexedDbInvestigationStore" as store
end box
box "Browser and device" #F2F4F7
  participant "Device" as device
  database "IndexedDB" as idb
end box

loop up to 50 per second on each of up to 4 characteristics (NFR-003)
  device --> ble : characteristicvaluechanged 0x2ACD
  ble -> ble : Copy the DataView bytes
  ble -> hex : toHex(bytes)
  hex --> ble : "0C 04 2C 01 …"
  ble -> log : append({ kind: notification, uuid, direction: in, hex, stepId })
  log -> log : id = next sequence; t = timeOrigin + performance.now() (FR-073)
  log -> log : Push to window; drop the oldest past 2,000 (NFR-005)
  log -> log : Queue for flush
  ble -> ble : Hand the bytes to the recorder or decoder
end
note over page, log : No Angular change detection per notification;\nthe count signal updates once per animation frame
log -> page : count and latest entries, once per frame
opt Batch size or interval reached
  log -> store : appendRawLog(batch)
  store -> idb : put entries in one transaction, tagged with stepId
  idb --> store : ok
  store --> log : flushed; batch released from memory
end
@enduml
