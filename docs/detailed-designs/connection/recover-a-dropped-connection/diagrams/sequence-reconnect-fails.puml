@startuml
title UML sequence behaviour — Three reconnects fail
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "ConnectionBanner" as banner
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "PlaybookOrchestrator" as orch
  participant "ConnectionSupervisor" as supervisor
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "reconnectTool" as tool
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "WebBluetoothBleLayer" as ble
end box
box "Browser and device" #F2F4F7
  participant "Device" as device
end box

supervisor -> tool : run({ deviceId, attempts: 3 })
loop attempts at 1 s, 2 s and 4 s
  tool -> ble : connect(deviceId)
  ble -> device : gatt.connect()
  device --> ble : no answer
  ble --> tool : TIMEOUT or CONNECTION_FAILED
end
tool --> supervisor : CONNECTION_FAILED after 3 attempts (TOOL-007)
supervisor -> banner : "Couldn't reconnect after 3 tries." with "Try again" and "Stop" (FR-016)
banner -> person : "Check the treadmill is on and within a few metres. Everything so far is saved."
alt The person taps "Try again"
  person -> banner : Try again
  banner --> supervisor : tryAgain()
  supervisor -> tool : run({ deviceId, attempts: 3 })
else The person taps "Stop"
  person -> banner : Stop
  banner --> supervisor : stop
  supervisor -> orch : stop("person"): verdict Stopped by the person (FR-009)
end
@enduml
