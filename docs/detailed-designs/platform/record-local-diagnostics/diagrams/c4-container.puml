@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Record local diagnostics

Person(person, "Person", "Developer or helper beside the machine")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "Diagnostics recorder, error message catalogue, error notices, error handler")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Diagnostic entries inside each investigation record")
}
System_Ext(device, "Device", "Bluetooth LE")

Rel(person, spa, "Sees the message; taps the offered next step", "Touch or keyboard")
Rel(spa, device, "Reads, writes, notifications that may fail", "Web Bluetooth")
Rel(spa, idb, "Commits each diagnostic entry with its step")
@enduml
