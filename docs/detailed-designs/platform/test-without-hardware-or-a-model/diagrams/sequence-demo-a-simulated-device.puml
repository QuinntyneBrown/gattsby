@startuml
title UML sequence behaviour — Demo a simulated device in a development build
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "App bootstrap" as boot
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "simulation.providers\n(development file)" as providers
  participant "WebBluetoothBleLayer" as ble
end box
box "Browser and device" #F2F4F7
  participant "SimulatedBluetooth" as sim
end box

dev -> boot : Open http://localhost:4200/?simulate=ftms-treadmill
boot -> providers : App initializer (development configuration only)
providers -> providers : Read ?simulate; look up the scripted device
providers -> sim : install(ftms-treadmill) on navigator.bluetooth
boot -> ble : Start; capability check sees Web Bluetooth
dev -> ble : (app) Tap "Find the device"
ble -> sim : requestDevice(...)
sim --> ble : HZN-T202-4F1A (scripted)
note over providers : The production build replaces this file with an empty one; no simulation code ships (NFR-023)
@enduml
