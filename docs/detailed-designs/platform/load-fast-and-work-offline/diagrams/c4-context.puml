@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Load fast and work offline

Person(person, "Person", "Developer or helper holding the phone or laptop, often on store Wi-Fi or none")
System(gattsby, "Gattsby", "Installable static web app in Chrome that identifies a Bluetooth device")
System_Ext(host, "Static host", "HTTPS host that serves Gattsby's static files and security headers")
System_Ext(chrome, "Chrome", "Service worker runtime, Cache Storage, install, Prompt API")
System_Ext(nano, "Gemini Nano", "On-device model, downloaded and cached by Chrome")

Rel(person, gattsby, "Opens it, online once, offline afterwards")
Rel(host, gattsby, "Serves static files once, with HSTS, CSP and the other headers", "HTTPS")
Rel(gattsby, chrome, "Registers a service worker; caches every static file")
Rel(chrome, nano, "Keeps the downloaded model", "Prompt API")
@enduml
