@startuml
title UML sequence behaviour — Export a full record
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "ExportDialog" as dialog
  participant "VerdictPage" as page
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "ExportService" as export
  participant "IndexedDbInvestigationStore" as store
end box
box "Browser and device" #F2F4F7
  database "IndexedDB" as idb
  participant "Chrome downloads" as downloads
end box

person -> page : Tap "Export full record"
page -> dialog : Open; box unticked (FR-063)
opt Person ticks "Include notes and photos"
  person -> dialog : Tick the box
end
person -> dialog : Tap "Full investigation record"
dialog --> page : exportRecord({ includeNotesAndPhotos })
page -> export : exportRecord(i-2c91, options, pending state if any)
export -> store : get(i-2c91)
store -> idb : readonly: investigation, steps, observations, hypotheses, recordings, requests, profile
idb --> store : Rows
store --> export : Record without the raw log
loop Raw log pages of 2,000 entries (NFR-005)
  export -> store : next rawLog page by cursor
  store --> export : Entries
  export -> export : Validate entries; serialise to a string part
end
alt Box ticked
  export -> store : photos and notes
  store --> export : Blobs and notes
  export -> export : Add photos as dataBase64 and notes
else Box unticked
  export -> export : omitted { notes, photos } counts only
end
export -> export : Validate the record envelope (investigation-record-1)
export -> downloads : Blob of parts; object URL; download horizon-t202-2026-11-25-record.gattsby.json
export -> export : revokeObjectURL
export --> page : Saved, 86 KB
page -> dialog : Success state
@enduml
