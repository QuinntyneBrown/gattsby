@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Export profiles and records

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(chrome, "Chrome", "Web Bluetooth stack, device chooser, Prompt API, camera, IndexedDB")

Rel(person, gattsby, "Starts an export; chooses whether to include notes and photos")
Rel(gattsby, chrome, "Reads the record; hands over a local blob: file", "IndexedDB, download")
Rel(chrome, person, "Saves the .gattsby.json file on the device")
@enduml
