@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Keep a history

Person(person, "Person", "Phone or laptop")
System_Boundary(gattsby, "Gattsby") {
  Container(spa, "Gattsby web app", "Angular (pending ADR 0001), TypeScript", "History page, delete dialog, investigation store")
  ContainerDb(idb, "Investigation database", "IndexedDB", "Investigations and everything recorded with them")
}
System_Ext(chrome, "Chrome", "StorageManager: usage and quota")

Rel(person, spa, "Opens Past investigations; deletes one", "Touch or keyboard")
Rel(spa, idb, "Lists newest first; deletes one record in one transaction")
Rel(spa, chrome, "Reads storage use")
@enduml
