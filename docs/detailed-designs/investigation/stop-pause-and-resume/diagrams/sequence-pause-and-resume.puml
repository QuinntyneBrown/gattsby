@startuml
title UML sequence behaviour — Pause and resume while connected
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "InvestigationPage" as inv
  participant "StillThereDialog" as dialog
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "AgentOrchestrator" as orch
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "WebBluetoothBleLayer" as ble
  participant "IndexedDbInvestigationStore" as store
end box

person -> inv : Tap Pause
inv -> orch : pause()
orch -> orch : stepAbort.abort(); the step in progress is not committed
orch -> ble : pauseSubscriptions()
ble --> orch : [0x2ACD] stopped, remembered
orch -> store : setStatus(paused, standard)
inv -> dialog : Paused (still-there/paused.html)
dialog --> person : "Nothing is sent or recorded while paused."\nStill connected; Emergency stop stays reachable
alt Resume
  person -> dialog : Tap Resume
  dialog --> inv : resume
  inv -> orch : resume()
  orch -> ble : restoreSubscriptions([0x2ACD])
  orch -> store : setStatus(running, standard)
  orch -> orch : Decide the next step afresh from the last committed one
else Save and exit
  person -> dialog : Tap "Save and exit"
  dialog --> inv : saveAndExit
  inv -> orch : leave(): status stays paused
  orch -> ble : disconnect() (FR-018)
  inv --> person : Home shows "Resume: ..." with "Paused at Standard path"
else Stop and get a verdict
  person -> dialog : Tap "Stop and get a verdict"
  inv -> orch : stop(stoppedByPerson)
  note right : As in the stop sequence
end
@enduml
