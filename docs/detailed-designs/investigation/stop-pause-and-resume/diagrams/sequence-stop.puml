@startuml
title UML sequence behaviour — Stop an investigation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "StopInvestigationDialog" as dialog
  participant "InvestigationPage" as page
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "PlaybookOrchestrator" as orch
  participant "PromptChannel" as channel
  participant "ConnectionReleaser" as rel
end box
box "Frontend — Gattsby web app: tools, knowledge base and analysis" #ECFDF3
  participant "VerdictBuilder" as vb
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "ApprovalLedger" as ledger
  participant "IndexedDbInvestigationStore" as store
end box
box "Browser and device" #F2F4F7
  participant "Device" as device
end box

person -> page : Options, "Stop and get a verdict now"
page -> dialog : "Stop this investigation?"
person -> dialog : Tap "Stop and get the verdict"
dialog -> dialog : Busy "Disconnecting… this takes up to 2 seconds."
dialog --> page : decided stop
page -> orch : stop('person')
orch -> orch : loopAbort.abort(): pending model call and tool (FR-047)
orch -> channel : cancel() the pending prompt
orch -> ledger : revokeAll(): no further command (FR-009)
orch -> rel : release(2000)
rel -> device : stopNotifications(), gatt.disconnect()
device --> rel : disconnected
rel --> orch : released within 2 s
orch -> vb : build(investigation, person)
vb --> orch : "Stopped by the person" with observations so far
orch -> store : commitStep(verdict, partial profile, status finished)
orch --> page : status ended
page -> person : Verdict page, state stopped
@enduml
