@startuml
title UML sequence behaviour — Prepare the device and the person
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "PromptCard" as card
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "AgentOrchestrator" as orch
  participant "PlaybookHeuristics" as heur
  participant "PromptChannel" as channel
end box
box "Frontend — Gattsby web app: tools, analysis and knowledge base" #ECFDF3
  participant "AskUserTool" as ask
  participant "RequestActionTool" as act
  participant "KnowledgeBase" as kb
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  participant "IndexedDbInvestigationStore" as store
end box

orch -> heur : prepareChecks(facts)
heur --> orch : check_capabilities
orch -> store : commitStep(capability report)
orch -> heur : prepareChecks(facts)
heur --> orch : ask_user machine type
orch -> ask : run("What kind of machine is it?", 6 answers)
ask -> ask : Add "Don't know" (TOOL-025)
ask -> channel : post(question, Question 1 of 3)
channel -> card : Treadmill, Bike, Rower, Cross-trainer,\nHeart-rate sensor, Other, Don't know (FR-008)
person -> card : Tap an answer or "Don't know"
card --> channel : PromptResponse
channel --> ask : answer
ask --> orch : ok; machineType treadmill or unknown
orch -> store : commitStep(answer, observation)
orch -> heur : prepareChecks(facts)
heur --> orch : ask_user brand
orch -> ask : run("Is there a brand on it?")
ask -> kb : brandSuggestions(treadmill)
kb --> ask : up to 5 brands
ask -> channel : post(question, free text allowed)
person -> card : Type "Horizon" or tap "Don't know"
card --> ask : answer
ask --> orch : ok; brand text or unknown (not an error, FR-008)
orch -> store : commitStep(answer, observation)
orch -> heur : prepareChecks(facts)
heur --> orch : request_action power on and disconnect others
orch -> act : run("Switch it on, then disconnect anything else...", needsReady false)
act -> channel : post(action, purpose line)
channel -> card : Instruction, purpose, "Done"
person -> card : Tap "Done"
card --> act : doneAt
act --> orch : ok
orch -> store : commitStep(action done); stage find
orch --> card : Find stage begins
@enduml
