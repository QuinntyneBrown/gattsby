@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Start an investigation

Person(person, "Person", "Beside the machine")
Container_Boundary(spa, "Gattsby web app") {
  Component(home, "HomePage", "Angular page, /", "Identify a device; re-checks, picks the mode, creates the record")
  Component(detector, "CapabilityDetector", "Service", "Re-runs the check before every investigation")
  Component(selector, "ModeSelector", "Service", "agent or checklist")
  Component(orch, "PlaybookOrchestrator", "Service (AgentOrchestrator)", "start(id); runs the Prepare stage")
  Component(rules, "PlaybookRules", "Pure helper", "Prepare: capabilities, type, brand, power on and disconnect")
  Component(channel, "PromptChannel", "Service", "Posts each question or action prompt")
  Component(note, "AddNoteDialog", "Angular dialog", "Optional location label and note")
  Component(kb, "KnowledgeBase", "Service", "version; vendor names")
  Component(store, "IndexedDbInvestigationStore", "Store", "create(), requestPersistence(), commitStep()")
}

Rel(person, home, "Taps Identify a device")
Rel(home, detector, "detect()")
Rel(home, selector, "select(preference)")
Rel(home, store, "create(), then requestPersistence()")
Rel(home, kb, "Reads version")
Rel(home, orch, "Navigates; start(id)")
Rel(orch, rules, "next(state) at Prepare")
Rel(orch, channel, "ask_user, request_action")
Rel(rules, kb, "Brand suggestions")
Rel(person, note, "Types a location label")
Rel(note, store, "Saves locationLabel")
Rel(orch, store, "commitStep(answer)")
@enduml
