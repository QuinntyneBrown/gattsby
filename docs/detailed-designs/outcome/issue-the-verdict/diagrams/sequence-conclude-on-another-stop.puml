@startuml
title UML sequence behaviour — Conclude on another stop
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Person" as person
box "Frontend — Gattsby web app: UI" #E0F2FE
  participant "StopInvestigationDialog" as dialog
end box
box "Frontend — Gattsby web app: agent orchestrator" #D1FADF
  participant "AgentOrchestrator\nor ChecklistRunner" as orch
  participant "StopConditions" as stop
end box
box "Frontend — Gattsby web app: tools, analysis and knowledge base" #ECFDF3
  participant "FinishTool" as finish
  participant "VerdictService" as verdicts
  participant "VerdictRules" as rules
end box
box "Frontend — Gattsby web app: adapters (BLE, model, store, camera)" #FFF4E5
  database "InvestigationStore" as store
end box

alt The person stops
  person -> dialog : Tap "Stop and get the verdict"
  dialog --> orch : stop requested (FR-009)
  orch -> orch : Abort the pending step; send nothing more; disconnect
  orch -> verdicts : decide(personStopped)
  verdicts --> orch : Stopped by the person
else Budget, no progress, threshold or emergency stop
  stop --> orch : StopReason stepBudget (FR-045)
  orch -> verdicts : decide(stepBudget)
  verdicts -> store : Read observations and requests
  verdicts -> rules : decide(stepBudget, facts) by precedence
  rules --> verdicts : e.g. Partially decoded
  verdicts --> orch : verdict kind
end
orch -> finish : run({ verdict, summary from template }, ctx)
finish -> verdicts : issue(kind, summary, stop reason)
finish -> store : commitStep(final step, verdict, stop reason, profile)
store --> finish : committed
finish --> orch : ok, { verdict, profileId }
note over orch, store : Checklist mode takes this path for every verdict (FR-049)
@enduml
