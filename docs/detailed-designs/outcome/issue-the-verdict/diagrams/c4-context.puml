@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Issue the verdict

Person(person, "Person", "Developer or helper holding the phone or laptop beside the machine")
System(gattsby, "Gattsby", "Static client-only web app in Chrome that identifies a Bluetooth device")
System_Ext(nano, "Gemini Nano", "On-device model behind Chrome's Prompt API (full agent mode only)")
System_Ext(chrome, "Chrome", "Prompt API, Web Bluetooth stack, IndexedDB and downloads")

Rel(person, gattsby, "Reads the verdict; exports or starts a new investigation")
Rel(gattsby, chrome, "Stores the verdict and profile; saves exported files", "IndexedDB, download")
Rel(chrome, nano, "Runs the prompt that may return finish")
@enduml
