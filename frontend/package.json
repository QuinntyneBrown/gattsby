{
  "name": "gattsby",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:dist": "node scripts/serve-dist.ts",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "e2e:memory": "playwright test --config playwright.memory.config.ts",
    "check:bundle": "node scripts/check-initial-bundle.ts",
    "check:headers": "node scripts/check-headers.ts",
    "e2e:critical": "playwright test --grep @critical",
    "kb": "node scripts/validate-knowledge-base.ts",
    "schemas": "node scripts/compile-schemas.ts",
    "prestart": "npm run kb && npm run schemas",
    "prebuild": "npm run kb && npm run schemas",
    "pretest": "npm run kb && npm run schemas",
    "prelint": "npm run kb && npm run schemas"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.10",
    "@types/web-bluetooth": "^0.0.22",
    "ajv": "^8.20.0",
    "angular-eslint": "22.8.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
