{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.js",
          "!/ngsw-worker.js",
          "!/safety-worker.js",
          "!/worker-basic.min.js",
          "/*.css",
          "/*.svg",
          "/*.webmanifest",
          "/icons/*.png",
          "/media/**",
          "/schemas/*.json",
          "/phone-model/manifest.json",
          "/phone-model/worker.js"
        ]
      }
    }
  ]
}
