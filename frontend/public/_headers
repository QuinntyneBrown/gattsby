# Security headers for every response (NFR-013, NFR-014; serve-offline-and-private design,
# ADR 0003). Format: Cloudflare Pages and Netlify `_headers`. Check a deployment with
# `npm run check:headers -- https://<deployed host>/`.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' blob:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types angular gattsby
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: bluetooth=(self), camera=(self), geolocation=(), microphone=(), payment=(), usb=(), serial=(), hid=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), fullscreen=(), clipboard-read=(), clipboard-write=(), publickey-credentials-get=(), screen-wake-lock=(), xr-spatial-tracking=()
