{
  "$id": "investigation-record-1.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gattsby investigation record 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "formatVersion",
    "kbVersion",
    "appVersion",
    "exportedAt",
    "includesNotesAndPhotos",
    "investigation",
    "steps",
    "rawLog",
    "observations",
    "hypotheses",
    "recordings",
    "missingToolRequests",
    "profile"
  ],
  "properties": {
    "kind": {
      "const": "gattsby.investigation-record"
    },
    "formatVersion": {
      "enum": ["1.0", "1.1"]
    },
    "kbVersion": {
      "type": "string"
    },
    "appVersion": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "includesNotesAndPhotos": {
      "type": "boolean"
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startedAt",
        "endedAt",
        "interruptedAt",
        "status",
        "mode",
        "stage",
        "deviceName",
        "lastCommittedStep",
        "profileId",
        "modelConsultations",
        "verdict"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "startedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "interruptedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": ["running", "paused", "concluded", "stopped"]
        },
        "mode": {
          "enum": ["agent", "checklist"]
        },
        "modeChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "reason", "stage", "step", "rejectedActionIds", "at"],
            "properties": {
              "from": { "const": "agent" },
              "to": { "const": "checklist" },
              "reason": {
                "enum": ["sessionFailed", "twoTimeouts", "contextExhausted", "threeInvalidActions"]
              },
              "stage": {
                "enum": [
                  "prepare",
                  "find",
                  "identify",
                  "standard",
                  "proprietary",
                  "control",
                  "conclude"
                ]
              },
              "step": { "type": "integer", "minimum": 1 },
              "rejectedActionIds": {
                "type": "array",
                "items": { "type": "string", "pattern": "^s-[1-9][0-9]*$" }
              },
              "at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              }
            }
          }
        },
        "stage": {
          "type": "string"
        },
        "deviceName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "string"
        },
        "lastCommittedStep": {
          "type": "integer",
          "minimum": 0
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelConsultations": {
          "type": "integer",
          "minimum": 0
        },
        "verdict": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "label",
                "protocol",
                "summary",
                "stopReason",
                "issuedAt",
                "stepN",
                "evidence"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "connected",
                    "partiallyDecoded",
                    "needsMissingTool",
                    "notConnectable",
                    "stoppedByPerson"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "protocol": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "stopReason": {
                  "type": "string"
                },
                "issuedAt": {
                  "type": "number"
                },
                "stepN": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "n",
          "stage",
          "tool",
          "action",
          "startedAt",
          "endedAt",
          "status",
          "result",
          "message",
          "exchange",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "n": {
            "type": "integer",
            "minimum": 0
          },
          "stage": {
            "enum": [
              "prepare",
              "find",
              "identify",
              "standard",
              "proprietary",
              "control",
              "conclude"
            ]
          },
          "tool": {
            "type": "string"
          },
          "mode": {
            "enum": ["agent", "checklist"]
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "request", "decision", "standClearConfirmed", "decidedAt"],
            "properties": {
              "id": { "type": "string" },
              "request": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool",
                  "title",
                  "detail",
                  "risk",
                  "isMotion",
                  "sequence",
                  "deviceId",
                  "connectedAt",
                  "service",
                  "characteristic",
                  "bytes"
                ],
                "properties": {
                  "tool": { "type": "string" },
                  "title": { "type": "string" },
                  "detail": { "type": "string" },
                  "risk": { "type": "string" },
                  "isMotion": { "type": "boolean" },
                  "sequence": { "type": "string" },
                  "deviceId": { "type": "string" },
                  "connectedAt": { "type": "number" },
                  "effect": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["metric", "from", "to", "baselineId"],
                    "properties": {
                      "metric": { "enum": ["speed", "resistance"] },
                      "from": { "type": "number" },
                      "to": { "type": "number" },
                      "baselineId": { "type": "string" }
                    }
                  },
                  "service": { "type": "string" },
                  "characteristic": { "type": "string" },
                  "bytes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": { "type": "integer", "minimum": 0, "maximum": 255 }
                  }
                }
              },
              "decision": { "enum": ["send", "decline", "cancel"] },
              "standClearConfirmed": { "type": "boolean" },
              "decidedAt": { "type": "number" }
            }
          },
          "modelDecision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startedAt", "promptTokens", "modelMs"],
            "properties": {
              "startedAt": { "type": "number" },
              "promptTokens": { "type": ["number", "null"] },
              "modelMs": { "type": "number", "minimum": 0 },
              "rawText": { "type": "string", "maxLength": 8192 }
            }
          },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "tool", "input", "decidedBy", "ruleId"],
            "properties": {
              "type": {
                "const": "call_tool"
              },
              "tool": {
                "type": "string"
              },
              "input": {},
              "decidedBy": {
                "enum": ["rules", "model", "checklist", "orchestrator"]
              },
              "ruleId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "startedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "endedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "status": {
            "enum": ["completed", "failed", "refused", "interrupted"]
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ok", "summary", "data", "error", "evidence"],
                "properties": {
                  "ok": {
                    "const": true
                  },
                  "summary": {
                    "type": "string"
                  },
                  "data": {},
                  "error": { "type": "null" },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ok", "summary", "data", "error", "evidence"],
                "properties": {
                  "ok": {
                    "const": false
                  },
                  "summary": {
                    "type": "string"
                  },
                  "data": { "type": "null" },
                  "error": {
                    "type": "object"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "message": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "exchange": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "answer", "skipped"],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "why": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "answer": {
                    "type": "string"
                  },
                  "skipped": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "rawLog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "seq", "stepN", "t", "kind", "direction", "hex"],
        "properties": {
          "id": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "stepN": {
            "type": "integer",
            "minimum": 0
          },
          "t": {
            "type": "number"
          },
          "kind": {
            "enum": [
              "scan",
              "advertisement",
              "connect",
              "disconnect",
              "read",
              "write",
              "notification",
              "indication"
            ]
          },
          "service": {
            "type": "string"
          },
          "uuid": {
            "type": "string"
          },
          "direction": {
            "enum": ["in", "out"]
          },
          "hex": {
            "type": "string"
          },
          "approvalId": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "decoded": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "decodeError": {
            "type": "string"
          },
          "recordingId": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stepN", "kind", "subject", "value", "text", "tag", "evidence"],
        "properties": {
          "id": {
            "type": "string"
          },
          "stepN": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tag": {
            "enum": ["confirmed", "likely", "guess"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "id",
          "stepN",
          "source",
          "previousVersion",
          "protocol",
          "label",
          "deviceType",
          "maker",
          "model",
          "confidence",
          "evidence",
          "contributions",
          "createdAt"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "stepN": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": ["model", "rules", "checklist"]
          },
          "previousVersion": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "protocol": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "deviceType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maker": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "number"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "proposedConfidence": {
            "type": "number"
          },
          "contributions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "weight", "observationIds"],
              "properties": {
                "rule": {
                  "type": "string"
                },
                "weight": {
                  "type": "number"
                },
                "observationIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "createdAt": {
            "type": "number"
          }
        }
      }
    },
    "recordings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stepN",
          "label",
          "characteristics",
          "startedAt",
          "seconds",
          "interrupted",
          "valueCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stepN": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "characteristics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "startedAt": {
            "type": "number"
          },
          "seconds": {
            "type": "number"
          },
          "interrupted": {
            "type": "boolean"
          },
          "valueCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "missingToolRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capabilityKey", "title", "reason"]
      }
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "device-profile-1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mediaType", "takenAt", "dataBase64"],
        "properties": {
          "id": {
            "type": "string"
          },
          "mediaType": {
            "enum": ["image/jpeg", "image/png", "image/webp"]
          },
          "takenAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "dataBase64": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]*={0,2}$"
          }
        }
      }
    },
    "omitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notes", "photos"],
      "properties": {
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "photos": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "if": {
    "properties": {
      "includesNotesAndPhotos": {
        "const": true
      }
    }
  },
  "then": {
    "required": ["notes", "photos"],
    "not": {
      "required": ["omitted"]
    }
  },
  "else": {
    "required": ["omitted"],
    "not": {
      "anyOf": [
        {
          "required": ["notes"]
        },
        {
          "required": ["photos"]
        }
      ]
    }
  }
}
