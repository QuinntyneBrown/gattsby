{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gattsby.app/schemas/knowledge-base.schema.json",
  "title": "Gattsby knowledge base data file",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^(0x[0-9a-f]{4}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 300 },
    "property": { "enum": ["read", "write", "writeWithoutResponse", "notify", "indicate"] },
    "deviceType": {
      "enum": ["treadmill", "bike", "rower", "cross-trainer", "heart-rate-sensor", "other"]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": { "enum": ["specification", "open-source", "documentation", "recording"] },
        "title": { "$ref": "#/$defs/text" },
        "reference": { "$ref": "#/$defs/text" },
        "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/citation" }
    },
    "fact": {
      "type": "object",
      "required": ["source"],
      "properties": { "source": { "type": "string", "minLength": 1 } }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "schemaVersion"],
      "properties": {
        "kind": { "const": "manifest" },
        "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}(\\.\\d+)?$" },
        "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
      }
    },
    "blocklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sources", "entries"],
      "properties": {
        "kind": { "const": "blocklist" },
        "sources": { "$ref": "#/$defs/sources" },
        "entries": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/fact" }],
            "type": "object",
            "additionalProperties": false,
            "required": ["uuid", "name", "exclusion", "source"],
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "name": { "$ref": "#/$defs/text" },
              "exclusion": { "enum": ["all", "reads", "writes"] },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "standard-service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "name",
        "shortName",
        "uuid",
        "scanFilter",
        "source",
        "characteristics",
        "profiles"
      ],
      "properties": {
        "kind": { "const": "standard-service" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "$ref": "#/$defs/text" },
        "shortName": { "$ref": "#/$defs/text" },
        "hypothesisLabel": { "$ref": "#/$defs/text" },
        "uuid": { "$ref": "#/$defs/uuid" },
        "scanFilter": { "type": "boolean" },
        "sharedWith": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/citation" },
        "characteristics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uuid", "name", "properties"],
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "name": { "$ref": "#/$defs/text" },
              "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
              "decoder": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "deviceType": { "$ref": "#/$defs/deviceType" },
              "field": { "type": "string", "pattern": "^[a-zA-Z]+$" }
            }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "deviceType", "requires", "expects"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "$ref": "#/$defs/text" },
              "deviceType": { "$ref": "#/$defs/deviceType" },
              "requires": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } },
              "expects": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
            }
          }
        }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "brand",
        "phase",
        "sources",
        "machineTypes",
        "services",
        "characteristics",
        "namePatterns",
        "manufacturerIds"
      ],
      "properties": {
        "kind": { "const": "vendor" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "brand": { "$ref": "#/$defs/text" },
        "phase": { "enum": ["MVP", "P2"] },
        "sources": { "$ref": "#/$defs/sources" },
        "machineTypes": { "type": "array", "items": { "$ref": "#/$defs/deviceType" } },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uuid", "name", "source"],
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "name": { "$ref": "#/$defs/text" },
              "source": { "type": "string" }
            }
          }
        },
        "characteristics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uuid", "service", "properties", "source"],
            "properties": {
              "uuid": { "$ref": "#/$defs/uuid" },
              "service": { "$ref": "#/$defs/uuid" },
              "name": { "$ref": "#/$defs/text" },
              "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
              "source": { "type": "string" }
            }
          }
        },
        "namePatterns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pattern", "source"],
            "properties": {
              "pattern": { "type": "string", "pattern": "^\\^", "maxLength": 80 },
              "prefix": { "type": "string", "minLength": 1, "maxLength": 29 },
              "source": { "type": "string" }
            }
          }
        },
        "manufacturerIds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "source": { "type": "string" }
            }
          }
        },
        "decoders": { "type": "array" },
        "safeLimits": { "type": "array" },
        "handshakes": { "type": "array" }
      }
    },
    "brand-suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "byMachineType"],
      "properties": {
        "kind": { "const": "brand-suggestions" },
        "note": { "type": "string" },
        "byMachineType": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      }
    }
  }
}
